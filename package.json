{
  "name": "@heyatom/client",
  "version": "1.2.0",
  "description": "Consumer SDK for the HeyAtom platform services: FileHarbor, Articuno, Beacon and Gatherly clients on native fetch, with optional NestJS modules and a Nuxt module for self-hosted Umami",
  "license": "MIT",
  "author": "Andrea Tombolato <hey@heyatom.dev> (https://heyatom.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyatomdev/heyatom-client.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./fileharbor": {
      "import": {
        "types": "./dist/esm/fileharbor/index.d.ts",
        "default": "./dist/esm/fileharbor/index.js"
      },
      "require": {
        "types": "./dist/cjs/fileharbor/index.d.ts",
        "default": "./dist/cjs/fileharbor/index.js"
      }
    },
    "./fileharbor/nest": {
      "import": {
        "types": "./dist/esm/fileharbor/nest/index.d.ts",
        "default": "./dist/esm/fileharbor/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/fileharbor/nest/index.d.ts",
        "default": "./dist/cjs/fileharbor/nest/index.js"
      }
    },
    "./articuno": {
      "import": {
        "types": "./dist/esm/articuno/index.d.ts",
        "default": "./dist/esm/articuno/index.js"
      },
      "require": {
        "types": "./dist/cjs/articuno/index.d.ts",
        "default": "./dist/cjs/articuno/index.js"
      }
    },
    "./articuno/nest": {
      "import": {
        "types": "./dist/esm/articuno/nest/index.d.ts",
        "default": "./dist/esm/articuno/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/articuno/nest/index.d.ts",
        "default": "./dist/cjs/articuno/nest/index.js"
      }
    },
    "./beacon": {
      "import": {
        "types": "./dist/esm/beacon/index.d.ts",
        "default": "./dist/esm/beacon/index.js"
      },
      "require": {
        "types": "./dist/cjs/beacon/index.d.ts",
        "default": "./dist/cjs/beacon/index.js"
      }
    },
    "./beacon/nest": {
      "import": {
        "types": "./dist/esm/beacon/nest/index.d.ts",
        "default": "./dist/esm/beacon/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/beacon/nest/index.d.ts",
        "default": "./dist/cjs/beacon/nest/index.js"
      }
    },
    "./gatherly": {
      "import": {
        "types": "./dist/esm/gatherly/index.d.ts",
        "default": "./dist/esm/gatherly/index.js"
      },
      "require": {
        "types": "./dist/cjs/gatherly/index.d.ts",
        "default": "./dist/cjs/gatherly/index.js"
      }
    },
    "./gatherly/nest": {
      "import": {
        "types": "./dist/esm/gatherly/nest/index.d.ts",
        "default": "./dist/esm/gatherly/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/gatherly/nest/index.d.ts",
        "default": "./dist/cjs/gatherly/nest/index.js"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/esm/webhooks/index.d.ts",
        "default": "./dist/esm/webhooks/index.js"
      },
      "require": {
        "types": "./dist/cjs/webhooks/index.d.ts",
        "default": "./dist/cjs/webhooks/index.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/esm/nuxt/module.d.ts",
        "default": "./dist/esm/nuxt/module.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "fileharbor": [
        "./dist/cjs/fileharbor/index.d.ts"
      ],
      "fileharbor/nest": [
        "./dist/cjs/fileharbor/nest/index.d.ts"
      ],
      "articuno": [
        "./dist/cjs/articuno/index.d.ts"
      ],
      "articuno/nest": [
        "./dist/cjs/articuno/nest/index.d.ts"
      ],
      "beacon": [
        "./dist/cjs/beacon/index.d.ts"
      ],
      "beacon/nest": [
        "./dist/cjs/beacon/nest/index.d.ts"
      ],
      "gatherly": [
        "./dist/cjs/gatherly/index.d.ts"
      ],
      "gatherly/nest": [
        "./dist/cjs/gatherly/nest/index.d.ts"
      ],
      "webhooks": [
        "./dist/cjs/webhooks/index.d.ts"
      ],
      "nuxt": [
        "./dist/esm/nuxt/module.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:di": "node scripts/di-smoke.cjs",
    "check:api": "node scripts/check-api.mjs",
    "openapi:dump": "pnpm --dir ../fileharbor openapi:dump \"$PWD/openapi/fileharbor.json\" && pnpm --dir ../articuno openapi:dump \"$PWD/openapi/articuno.json\" && pnpm --dir ../beacon openapi:dump \"$PWD/openapi/beacon.json\" && pnpm --dir ../gatherly openapi:dump \"$PWD/openapi/gatherly.json\"",
    "gen:types": "node scripts/gen-types.mjs",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build && pnpm test:di"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "@heyatom/bastion-client": ">=0.3.0",
    "@nestjs/common": "^11.0.0",
    "@nuxt/kit": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@heyatom/bastion-client": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heyatom/bastion-client": "^0.9.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nuxt/kit": "^4.6.3",
    "@types/node": "^26.6.3",
    "h3": "^1.15.11",
    "nitropack": "^2.13.5",
    "nuxt": "^4.6.3",
    "openapi-typescript": "^7.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
